// -- DOCUMENTATION -- //


// -- ROBOT SPAWNS -- //
// spawnbot ( spread across all 3 randomly )
// spawnbot_right
// spawnbot_mid
// spawnbot_left
//
// spawnbot_right_giant
// spawnbot_mid_giant
// spawnbot_left_giant
// ( these giant spawns just give them more space on top of a platform to spawn on, just in case, i used them to ensure bosses dont get stuck since they tend to be larger. )
//
// spawnbot_mission_sentrybuster
// spawnbot_mission_sniper
// spawnbot_mission_spy


// -- TANK PATHS -- //
// tank_path_right_1
// tank_path_left_1

// -- TANK TYPES -- //
// tank_bulldozer
// tank_roller


// -- TAGS -- //
// giant ( helps giants avoid certain areas they would otherwise get stuck in, reccomend giving this tag to ALL your giants, even 1.5 scale ones )

// -- WAVE STARTS -- //
// wave_start_relay
// wave_start_ironman_relay ( 30 second timer )

// -- MISC -- //
// pits_close_relay ( closes deathpits to prevent cheeseing bosses )
// pits_open_relay

#base robot_standard.pop
#base robot_giant.pop
WaveSchedule
{
StartingCurrency 1000
RespawnWaveTime 3
FixedRespawnWaveTime yes
CanBotsAttackWhileInSpawnRoom no

Mission // Sentry Busters
	{
		Objective	DestroySentries
		Where spawnbot_mid_giant
		BeginAtWave	1
		RunForThisManyWaves	7
		InitialCooldown	45
		CooldownTime	45
		DesiredCount	1
		TFBot
		{
		        Template        T_TFBot_SentryBuster
				Item "The Data Mining Light"
				Name "Demolition Crew"
				CharacterAttributes
			{
				"head scale" 3
                "torso scale" 0.2
                "voice pitch scale" 1.5
			}
			Tag Giant
		}
	}

